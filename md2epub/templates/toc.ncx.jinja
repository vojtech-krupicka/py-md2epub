<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ncx PUBLIC "-//NISO//DTD ncx 2005-1//EN" "http://www.daisy.org/z3986/2005/ncx-2005-1.dtd">

<ncx version="2005-1" xml:lang="en" xmlns="http://www.daisy.org/z3986/2005/ncx/">

    <head>
        <meta name="dtb:uid" content="{{ manifest.book_id.value }}"/> <!-- same as in .opf -->
        <meta name="dtb:depth" content="1"/> <!-- 1 or higher -->
        <meta name="dtb:totalPageCount" content="0"/> <!-- must be 0 -->
        <meta name="dtb:maxPageNumber" content="0"/> <!-- must be 0 -->
    </head>

    <docTitle>
        <text>{{ manifest.title }}</text>
    </docTitle>

    <docAuthor>
        <text>{{ manifest.author.file_as }}</text>
    </docAuthor>

{% set index = namespace(value=0) %}
{%- macro printNavPoint(item, level, base_path) %}
    {%- for child in item.children %}
    {%- set index.value = index.value + 1 %}
    {%- set clsmap = {0: "book", 1: "chapter", 2: "section"} %}
    {%- set cls = clsmap.get(level, "section") %}
        <navPoint class="{{ cls }}" id="{{ cls }}-{{ index.value }}" playOrder="{{ index.value }}" level="{{ level }}">
            <navLabel><text>{{ child.name }}</text></navLabel>
            <content src="{{ child|href(item.source, base_path) }}"/>
            {{ printNavPoint(child, level+1, base_path) }}
        </navPoint>
    {%- endfor %}
{%- endmacro%}

    <navMap>
        {{ printNavPoint(toc, 0, work_dir) }}
    </navMap>

</ncx>