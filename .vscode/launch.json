    "version": "0.2.0",
    "configurations": [
        {
            "name": "Md2ePub -- build",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "module": "md2epub",
            "args": [
                "build",
                "-v",
                "/app/examples/witcher/",
                "examples",
                "--overwrite"
            ]
        },
        {
            "name": "Md2ePub -- help",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "module": "md2epub",
            "args": [
                "-v",
                "--help"
            ]
        },
        {
            "name": "Md2ePub -- version",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "module": "md2epub",
            "args": [
                "-v",
                "--version"
            ]
        }
    ]
}