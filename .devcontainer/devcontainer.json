{
  "name": "MD to ePUB",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "build": {
      "context": "${localWorkspaceFolder}",
      "dockerfile": "${localWorkspaceFolder}/Dockerfile"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/app,type=bind",
    //"source=${localWorkspaceFolder}/../my-cv,target=/app/data,type=bind"
  ],
  "remoteUser": "vscode",
  "workspaceFolder": "/app"
}
